# Copy to .env.local and adjust. These are server-side only (not exposed to
# the browser).
#
# Drupal CMS base URL. Content is read from {DRUPAL_API_URL}/jsonapi/node/home_page
DRUPAL_API_URL=https://devcms.sonata-software.com
# Seconds before Next.js re-fetches CMS content (default 300)
DRUPAL_REVALIDATE=300
